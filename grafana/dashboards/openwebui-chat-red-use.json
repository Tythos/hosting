          "legendFormat": "load1",
          "refId": "A"
        }
      ],
      "title": "USE — Load average (saturation proxy)",
      "type": "timeseries"
    },
    {
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 16 },
      "id": 99,
      "options": {
        "content": "**Open WebUI / chat** RED metrics come from **Traefik** Prometheus scrape (`traefik_service_*`, `service=\"chat@docker\"`). USE panels are **node_exporter** on the Docker host. If series are empty, verify label names in **Explore** (Traefik Docker provider naming can differ slightly).",
        "mode": "markdown"
